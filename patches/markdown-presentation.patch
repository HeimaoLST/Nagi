+func TestHeadingUppercaseCopiesOriginalRanges(t *testing.T) {
+	src := "Before Mixed.\n\n###### Straße &amp; ﬃ e\u0301 `MiXeD` [Same](https://example.com/x) [Same](https://example.com/x)\n\nAfter Mixed.\n\n```txt\nStraße MiXeD\n```\n"
+	o := &Options{Theme: &Theme{}}
+	o.Theme.Headings[5].Uppercase = true
+	tt, get := rvView(&src, o)
+	st := get()
+	display := "STRASSE & FFI E\u0301 MIXED SAME SAME"
+	if got := rvParaText(st, 2); got != display {
+		t.Fatalf("display=%q, want %q", got, display)
+	}
+	if st.doc.Source() != src || !tt.HasText("Straße MiXeD") {
+		t.Fatal("source or fenced code was transformed")
+	}
+	k := rvElemOf(t, st, 2)
+	for _, c := range []struct {
+		from, to  int
+		plain, md string
+	}{
+		{4, 5, "ß", "ß"}, {5, 6, "ß", "ß"}, {4, 6, "ß", "ß"}, {5, 5, "", ""},
+		{10, 11, "ﬃ", "ﬃ"}, {11, 13, "ﬃ", "ﬃ"}, {8, 9, "&", "&amp;"},
+	} {
+		parts := []ui.SelectedText{rvPart(st, k, display, c.from, c.to)}
+		if got := st.copyText(parts); got != c.plain {
+			t.Errorf("[%d:%d] plain=%q, want %q", c.from, c.to, got, c.plain)
+		}
+		if got := st.copyMarkdown(parts); got != c.md {
+			t.Errorf("[%d:%d] Markdown=%q, want %q", c.from, c.to, got, c.md)
+		}
+		html, err := st.copyData(parts).Read(transfer.HTML)
+		if err != nil || c.plain != "" && !strings.Contains(string(html), c.plain) && c.plain != "&" {
+			t.Errorf("[%d:%d] HTML=%q err=%v", c.from, c.to, html, err)
+		}
+	}
+	r, _ := tt.Find("Before Mixed.")
+	tt.ClickAt(r.X+2, r.Y+r.H/2)
+	tt.Command("selectAll")
+	tt.Command("copy")
+	wantPlain := "Before Mixed.\n\nStraße & ﬃ e\u0301 MiXeD Same Same\n\nAfter Mixed.\n\nStraße MiXeD"
+	if got := tt.Clipboard(); got != wantPlain {
+		t.Errorf("real selection copy=%q, want %q", got, wantPlain)
+	}
+	// Cross-block selection stops at the last painted code line, as before.
+	md, err := tt.ClipboardData().Read(transfer.Markdown)
+	if err != nil || string(md) != strings.TrimSuffix(src, "\n```\n") {
+		t.Errorf("real selection Markdown=%q err=%v", md, err)
+	}
+	html, err := tt.ClipboardData().Read(transfer.HTML)
+	if err != nil || !strings.Contains(string(html), "Straße &amp; ﬃ") || strings.Contains(string(html), "STRASSE") {
+		t.Errorf("real selection HTML=%q err=%v", html, err)
+	}
+	if st.headingNamed(Slug("Straße & ﬃ e\u0301 MiXeD Same Same")) != 2 {
+		t.Fatal("heading anchor changed with display")
+	}
+	beforeID := st.elems[k].id
+	o.Theme.Headings[5].Uppercase = false
+	tt.Frame()
+	if rvParaText(get(), 2) != "Straße & ﬃ e\u0301 MiXeD Same Same" || get().elems[k].id != beforeID {
+		t.Fatal("heading style cache failed to invalidate or replaced identity")
+	}
+}
