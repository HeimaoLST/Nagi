+func TestHeadingUppercaseObjectsAndStreamIdentity(t *testing.T) {
+	var m mathRecorder
+	o := m.options()
+	o.Theme = &Theme{}
+	o.Theme.Headings[5].Uppercase = true
+	o.Reveal = &Reveal{Unit: AtOnce, Fade: -1}
+	src, done := "###### Straße $x$ [MiXeD](https://example.com/x)\n\nOriginal body.", false
+	var st *viewState
+	tt := ui.NewTester(func(c *ui.Context) {
+		var root ui.Element
+		if done {
+			root = View(c, src, o)
+		} else {
+			root = Stream(c, src, o)
+		}
+		st = *ui.Local(root, stateKey{}, newState)
+	}, 600, 400)
+	text := rvParaText(st, 1)
+	if text != "STRASSE \uFFFC MIXED" {
+		t.Fatalf("display=%q", text)
+	}
+	if r, ok := m.drawn["x"]; !ok || r.W != 20 || r.H != 16 {
+		t.Fatalf("expanded heading lost actual math drawing: %+v found=%t", r, ok)
+	}
+	k := rvElemOf(t, st, 1)
+	parts := []ui.SelectedText{rvPart(st, k, text, 8, 9)}
+	if got := st.copyText(parts); got != "$x$" {
+		t.Fatalf("object plain=%q", got)
+	}
+	if got := st.copyMarkdown(parts); got != "$x$" {
+		t.Fatalf("object Markdown=%q", got)
+	}
+	r, _ := tt.Find(text)
+	tt.ClickAt(r.X+2, r.Y+r.H/2)
+	tt.Command("selectAll")
+	tt.Command("copy")
+	selected, identity := tt.Clipboard(), st.elems[k].id
+	src += " Appended."
+	tt.Frame()
+	done = true
+	tt.Frame()
+	tt.Command("copy")
+	if tt.Clipboard() != selected || st.elems[k].id != identity {
+		t.Fatalf("stream->View changed selection or identity: copied=%q want=%q", tt.Clipboard(), selected)
+	}
+}
