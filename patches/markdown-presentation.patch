+func TestHeadingUppercaseKeepsLinkController(t *testing.T) {
+	src := "###### [MiXeD](https://example.com/x) [Again](https://example.com/x) [Unsafe](javascript:alert(1))\n"
+	var ids []uint64
+	o := &Options{Theme: &Theme{}}
+	o.Theme.Headings[5].Uppercase = true
+	o.LinkElement = func(c *ui.Context, block, inline int, dest string, e ui.Element) {
+		if block != 1 || inline < 0 {
+			t.Fatal("link parsed identity changed")
+		}
+		ids = append(ids, e.ID())
+	}
+	tt, _ := rvView(&src, o)
+	if len(ids) < 3 || ids[len(ids)-3] == ids[len(ids)-2] {
+		t.Fatal("duplicate destinations lost distinct link identities")
+	}
+	before := append([]uint64(nil), ids[len(ids)-3:]...)
+	ids = nil
+	tt.Frame()
+	if !slices.Equal(before, ids[len(ids)-3:]) {
+		t.Fatal("heading link identity changed on unchanged frame")
+	}
+	if err := tt.Click("UNSAFE"); err != nil {
+		t.Fatal(err)
+	}
+	if len(tt.OpenedURLs()) != 0 {
+		t.Fatal("unsafe uppercase link opened")
+	}
+	if err := tt.Click("MIXED"); err != nil {
+		t.Fatal(err)
+	}
+	if got := tt.OpenedURLs(); !slices.Equal(got, []string{"https://example.com/x"}) {
+		t.Fatalf("safe original destination=%q", got)
+	}
+	var calls []string
+	o.OnLink = func(dest string) { calls = append(calls, dest) }
+	tt.Frame()
+	tt.SetFocused(true)
+	for i := 0; i < 10 && !tt.Focused("AGAIN"); i++ {
+		tt.Key(0, ui.KeyTab)
+		tt.Frame()
+	}
+	if !tt.Focused("AGAIN") {
+		t.Fatal("uppercase duplicate link not keyboard reachable")
+	}
+	tt.Key(0, ui.KeyEnter)
+	if !slices.Equal(calls, []string{"https://example.com/x"}) {
+		t.Fatalf("keyboard callback=%q", calls)
+	}
+}
