+func TestHeadingUppercasePendingLinkDoesNotOpen(t *testing.T) {
+	src := "###### Read [MiXeD](https://example.com"
+	o := &Options{Theme: &Theme{}, Reveal: &Reveal{Unit: AtOnce, Fade: -1}}
+	o.Theme.Headings[5].Uppercase = true
+	tt := ui.NewTester(func(c *ui.Context) { Stream(c, src, o) }, 600, 200)
+	for i := 0; i < 10 && !tt.Focused("MIXED"); i++ {
+		tt.Key(0, ui.KeyTab)
+		tt.Frame()
+	}
+	if !tt.Focused("MIXED") {
+		t.Fatal("pending uppercase link not keyboard reachable")
+	}
+	tt.Key(0, ui.KeyEnter)
+	if len(tt.OpenedURLs()) != 0 {
+		t.Fatal("pending uppercase link opened")
+	}
+	src += "/docs)"
+	tt.Frame()
+	if err := tt.Click("MIXED"); err != nil {
+		t.Fatal(err)
+	}
+	if got := tt.OpenedURLs(); !slices.Equal(got, []string{"https://example.com/docs"}) {
+		t.Fatalf("finished original destination=%q", got)
+	}
