+// Each displayed range belongs to one original decoded rune. Selecting
+// any nonempty part of an expansion copies that original unit once.
+type displayRange struct{ start, end, original int }
+
+func (p *para) uppercase() {
+	var original strings.Builder
+	upper := cases.Upper(language.Und)
+	at, source := 0, 0
+	for i := range p.pieces {
+		for j := range p.pieces[i].spans {
+			sp := &p.pieces[i].spans[j]
+			original.WriteString(sp.Text)
+			var display strings.Builder
+			for _, r := range sp.Text {
+				text := upper.String(string(r))
+				n := utf8.RuneCountInString(text)
+				p.display = append(p.display, displayRange{at, at + n, source})
+				at, source = at+n, source+1
+				display.WriteString(text)
+			}
+			sp.Text = display.String()
+		}
+	}
+	p.original = original.String()
+}
+
+func (p *para) originalBoundary(r int, end bool) int {
+	if len(p.display) == 0 {
+		return r
+	}
+	lo, hi := 0, len(p.display)
+	for lo < hi {
+		m := (lo + hi) / 2
+		if p.display[m].end <= r {
+			lo = m + 1
+		} else {
+			hi = m
+		}
+	}
+	if lo == len(p.display) {
+		return p.runes
+	}
+	u := p.display[lo]
+	if end && r > u.start {
+		return u.original + 1
+	}
+	return u.original
 }
 
